{"ghsa_id":"GHSA-gpvr-g6gh-9mc2","cve_id":"CVE-2014-6393","url":"https://api.github.com/advisories/GHSA-gpvr-g6gh-9mc2","html_url":"https://github.com/advisories/GHSA-gpvr-g6gh-9mc2","summary":"No Charset in Content-Type Header in express","description":"Vulnerable versions of express do not specify a charset field in the content-type header while displaying 400 level response messages. The lack of enforcing user's browser to set correct charset, could be leveraged by an attacker to perform a cross-site scripting attack, using non-standard encodings, like UTF-7.\n\n\n## Recommendation\n\nFor express 3.x, update express to version 3.11 or later.\nFor express 4.x, update express to version 4.5 or later. ","type":"reviewed","severity":"medium","repository_advisory_url":null,"source_code_location":"","identifiers":[{"value":"GHSA-gpvr-g6gh-9mc2","type":"GHSA"},{"value":"CVE-2014-6393","type":"CVE"}],"references":["https://nvd.nist.gov/vuln/detail/CVE-2014-6393","https://github.com/advisories/GHSA-gpvr-g6gh-9mc2","https://www.npmjs.com/advisories/8","https://bugzilla.redhat.com/show_bug.cgi?id=1203190"],"published_at":"2018-10-23T17:22:54Z","updated_at":"2023-02-01T05:03:41Z","github_reviewed_at":"2020-06-16T21:37:54Z","nvd_published_at":"2017-08-09T18:29:00Z","withdrawn_at":null,"vulnerabilities":[{"package":{"ecosystem":"npm","name":"express"},"vulnerable_version_range":"< 3.11.0","first_patched_version":"3.11.0","vulnerable_functions":[]},{"package":{"ecosystem":"npm","name":"express"},"vulnerable_version_range":">= 4.0.0, < 4.5.0","first_patched_version":"4.5.0","vulnerable_functions":[]}],"cvss_severities":{"cvss_v3":{"vector_string":"CVSS:3.0/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","score":6.1},"cvss_v4":{"vector_string":null,"score":0.0}},"cwes":[{"cwe_id":"CWE-79","name":"Improper Neutralization of Input During Web Page Generation ('Cross-site Scripting')"}],"credits":[],"comments":0,"cvss":{"vector_string":"CVSS:3.0/AV:N/AC:L/PR:N/UI:R/S:C/C:L/I:L/A:N","score":6.1}