:[{"sha":"8b0caea3f6b2980c96db32d897e315fdfb5227a6","filename":"lodash.js","status":"modified","additions":4,"deletions":0,"changes":4,"blob_url":"https://github.com/lodash/lodash/blob/c84fe82760fb2d3e03a63379b297a1cc1a2fce12/lodash.js","raw_url":"https://github.com/lodash/lodash/raw/c84fe82760fb2d3e03a63379b297a1cc1a2fce12/lodash.js","contents_url":"https://api.github.com/repos/lodash/lodash/contents/lodash.js?ref=c84fe82760fb2d3e03a63379b297a1cc1a2fce12","patch":"@@ -3990,6 +3990,10 @@\n         var key = toKey(path[index]),\n             newValue = value;\n \n+        if (key === '__proto__' || key === 'constructor' || key === 'prototype') {\n+          return object;\n+        }\n+\n         if (index != lastIndex) {\n           var objValue = nested[key];\n           newValue = customizer ? customizer(objValue, key, nested) : undefined;"},{"sha":"73a5875baa24536adc5ec6919c1bf1033abb617e","filename":"test/test.js","status":"modified","additions":33,"deletions":0,"changes":33,"blob_url":"https://github.com/lodash/lodash/blob/c84fe82760fb2d3e03a63379b297a1cc1a2fce12/test%2Ftest.js","raw_url":"https://github.com/lodash/lodash/raw/c84fe82760fb2d3e03a63379b297a1cc1a2fce12/test%2Ftest.js","contents_url":"https://api.github.com/repos/lodash/lodash/contents/test%2Ftest.js?ref=c84fe82760fb2d3e03a63379b297a1cc1a2fce12","patch":"@@ -25799,6 +25799,39 @@\n     });\n   });\n \n+  // zipObjectDeep prototype pollution\n+  ['__proto__', 'constructor', 'prototype'].forEach(function (keyToTest) {\n+    QUnit.test('zipObjectDeep is not setting ' + keyToTest + ' on global', function (assert) {\n+      assert.expect(1);\n+\n+      _.zipObjectDeep([keyToTest + '.a'], ['newValue']);\n+      // Can't access plain `a` as it's not defined and test fails\n+      assert.notEqual(root['a'], 'newValue');\n+    });\n+\n+    QUnit.test('zipObjectDeep is not overwriting ' + keyToTest + ' on vars', function (assert) {\n+      assert.expect(3);\n+\n+      const b = 'oldValue'\n+      _.zipObjectDeep([keyToTest + '.b'], ['newValue']);\n+      assert.equal(b, 'oldValue');\n+      assert.notEqual(root['b'], 'newValue');\n+\n+      // ensure nothing was created\n+      assert.notOk(root['b']);\n+    });\n+\n+    QUnit.test('zipObjectDeep is not overwriting global.' + keyToTest, function (assert) {\n+      assert.expect(2);\n+\n+      _.zipObjectDeep([root + '.' + keyToTest + '.c'], ['newValue']);\n+      assert.notEqual(root['c'], 'newValue');\n+\n+      // ensure nothing was created\n+      assert.notOk(root['c']);\n+    });\n+  });\n+\n   /*--------------------------------------------------------------------------*/\n \n   QUnit.module('lodash.zipWith');"}]}