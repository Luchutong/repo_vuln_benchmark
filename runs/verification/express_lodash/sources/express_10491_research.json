ology">Quarkus</p><div fs-list-field="Type" class="hide">Java</div></a></div><div role="listitem" class="w-dyn-item"><a aria-label="product page" href="/support/rails-nes" class="block-products_home w-inline-block"><img src="https://cdn.prod.website-files.com/62876589ec366575fa309b1e/65cfe0083e603b6d7501d202_Ruby%20on%20rails%20-%20icon.svg" loading="lazy" width="44" height="44" alt="" class="logo-products_home"><div class="line-vertical-products_home"></div><p fs-list-field="Technology">Rails</p><div fs-list-field="Type" class="hide">Other</div></a></div><div role="listitem" class="w-dyn-item"><a aria-label="product page" href="/support/nes-for-react" class="block-products_home w-inline-block"><img src="https://cdn.prod.website-files.com/62876589ec366575fa309b1e/6a6a2e89176f464c491a13f8_React%20logo.png" loading="lazy" width="44" height="44" alt="" class="logo-products_home"><div class="line-vertical-products_home"></div><p fs-list-field="Technology">React</p><div fs-list-field="Type" class="hide">JavaScript</div></a></div><div role="listitem" class="w-dyn-item"><a aria-label="product page" href="/support/vuetify-nes" class="block-products_home w-inline-block"><img src="https://cdn.prod.website-files.com/62876589ec366575fa309b1e/67c73c012ca3e03544372562_Vuetify%20logo.svg" loading="lazy" width="44" height="44" alt="" class="logo-products_home"><div class="line-vertical-products_home"></div><p fs-list-field="Technology">Vuetify</p><div fs-list-field="Type" class="hide">JavaScript</div></a></div></div></div><div class="hide w-embed w-script"><script>
  (function () {
    function initProductNavFilter() {
      const list = document.querySelector('.list-technologies_navbar');
      const categoryForm = document.getElementById('wf-form-Filter-left-navbar');
      const searchInput = document.querySelector('#wf-form-Filter-search-bar-navbar input[name="name"]');
      const emptyState = document.getElementById('empty-products');
      const emptyStateName = document.getElementById('product-name-empty');
      const featuredFrameworksTitle = document.getElementById('featured-frameworks'); // NEW

      if (!list || !categoryForm || !searchInput) return;

      const items = Array.from(list.querySelectorAll('.w-dyn-item')).map((item) => {
        const techEl = item.querySelector('[fs-list-field="Technology"]');
        const typeEl = item.querySelector('[fs-list-field="Type"]');
        const featuredEl = item.querySelector('[fs-list-field="Featured"]');
        return {
          el: item,
          technology: ((techEl && techEl.textContent) || '').trim(),
          type: ((typeEl && typeEl.textContent) || '').trim(),
          featured: !!featuredEl,
        };
      });

      const categoryRadios = Array.from(categoryForm.querySelectorAll('input[type="radio"]'));
      const featuredRadio = categoryForm.querySelector('#featured');

      function showItem(item, show) {
        item.el.style.display = show ? '' : 'none';
      }

      function setActiveLabel(radio) {
        categoryRadios.forEach((r) => {
          const label = r.closest('label');
          if (label) label.classList.toggle('is-active', r === radio);
        });
      }

      // NEW: only shows the title when the Featured radio is the active one
      function toggleFeaturedFrameworksTitle(isFeatured) {
        if (!featuredFrameworksTitle) return;
        featuredFrameworksTitle.style.display = isFeatured ? '' : 'none';
      }

      function applyEmptyState(visibleCount, query) {
        if (!emptyState) return;
        emptyState.style.display = visibleCount === 0 ? '' : 'none';
        if (emptyStateName) emptyStateName.textContent = query || '';
      }

      function filterByCategory(radio) {
        const field = radio.getAttribute('fs-list-field');
        const value = radio.getAttribute('fs-list-value');
        let visibleCount = 0;

        items.forEach((item) => {
          const match = field === 'Featured' ? item.featured : item.type === value;
          if (match) visibleCount++;
          showItem(item, match);
        });

        setActiveLabel(radio);
        toggleFeaturedFrameworksTitle(field === 'Featured'); // NEW
        applyEmptyState(visibleCount);
      }

      function filterBySearch(query) {
        const q = query.trim().toLowerCase();
        let visibleCount = 0;

        items.forEach((item) => {
          const match = item.technology.toLowerCase().includes(q);
          if (match) visibleCount++;
          showItem(item, match);
        });

        setActiveLabel(null);
        toggleFeaturedFrameworksTitle(false); // NEW — search results aren't "Featured Frameworks"
        applyEmptyState(visibleCount, query);
      }

      function clearCategoryRadios() {
        categoryRadios.forEach((radio) => {
          radio.checked = false;
        });
      }

      if (featuredRadio) {
        featuredRadio.checked = true;
        filterByCategory(featuredRadio);
      }

      categoryForm.addEventListener('change', (e) => {
        if (!e.target.matches('input[type="radio"]')) return;
        if (searchInput.value) searchInput.value = '';
        filterByCategory(e.target);
      });

      searchInput.addEventListener('input', () => {
        if (searchInput.value.length > 0) {
          clearCategoryRadios();
          filterBySearch(searchInput.value);
        } else if (featuredRadio) {
          featuredRadio.checked = true;
          filterByCategory(featuredRadio);
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initProductNavFilter);
    } else {
      initProductNavFilter();
    }
  })();
