  window.addEventListener("DOMContentLoaded", function () {
    var techElement = document.querySelector('[data-technology]');
    
    if (techElement) {
      var rawValue = techElement.textContent.trim();

      // Convert to lowercase and replace spaces with hyphens
      var techSlug = rawValue.toLowerCase().replace(/\s+/g, '-');

      var currentUrl = new URL(window.location.href);

      // Only add if no query string is present
      if (!currentUrl.search) {
        currentUrl.search = '?' + encodeURIComponent(techSlug);
        window.history.replaceState({}, '', currentUrl);
      }
    }
  });
