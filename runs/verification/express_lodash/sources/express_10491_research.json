    const DEFAULT_THEME = 'github-dark';

    const LANGUAGE_ALIASES = {
      js: 'javascript',
      ts: 'typescript',
      py: 'python',
      rb: 'ruby',
      sh: 'bash',
      shell: 'bash',
      yml: 'yaml',
      md: 'markdown',
      cs: 'csharp',
      rs: 'rust',
      gql: 'graphql',
      docker: 'dockerfile',
      txt: 'text',
      plaintext: 'text',
      plain: 'text',
    };

    let highlighterPromise;

    // Prevent two blocks requesting the same language simultaneously
    // from triggering two language loads.
    const languageLoads = new Map();

    function normalizeLanguage(language = 'text') {
      const value = language.trim().toLowerCase();
      return LANGUAGE_ALIASES[value] ?? value;
    }

    function getHighlighter() {
      if (!highlighterPromise) {
        highlighterPromise = import(SHIKI_URL).then(({ createHighlighter }) =>
          createHighlighter({
            themes: [DEFAULT_THEME],
            langs: [],
          }),
        );
      }

      return highlighterPromise;
    }

    async function ensureLanguage(highlighter, language) {
      // Shiki treats plain text specially; there's no grammar to load.
      if (language === 'text') {
        return language;
      }

      if (highlighter.getLoadedLanguages().includes(language)) {
        return language;
      }

      if (!languageLoads.has(language)) {
        languageLoads.set(
          language,
          highlighter.loadLanguage(language).then(() => language),
        );
      }

      return languageLoads.get(language);
    }

    function normalizeSource(source) {
      // Lets the HTML be formatted like:
      //
      // <pre><code>
      // const foo = 1
      // </code></pre>
      //
      // without showing the markup-only first/last newline.

      return source.replace(/^\n/, '').replace(/\n[ \t]*$/, '');
    }

    function createToolbar({ label, language, source }) {
      const toolbar = document.createElement('div');
      toolbar.className = 'shiki-code__toolbar';

      const title = document.createElement('span');
      title.className = 'shiki-code__label';
      title.textContent = label || language;

      const copy = document.createElement('button');
      copy.className = 'shiki-code__copy';
      copy.type = 'button';
      copy.textContent = 'Copy';
      copy.setAttribute('aria-label', 'Copy code');

      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(source);

          copy.textContent = 'Copied';

          setTimeout(() => {
            copy.textContent = 'Copy';
          }, 1500);
        } catch (error) {
          console.warn('Could not copy code', error);
          copy.textContent = 'Copy failed';
        }
      });

      toolbar.append(title, copy);

      return toolbar;
    }

    class ShikiCode extends HTMLElement {
      async connectedCallback() {
        if (this.dataset.shikiState) {
          return;
        }

        const fallbackPre = this.querySelector('pre');
        const fallbackCode = fallbackPre?.querySelector('code') ?? fallbackPre;

        // Leave malformed blocks alone instead of destroying their contents.
        if (!fallbackCode) {
          return;
        }

        const source = normalizeSource(fallbackCode.textContent ?? '');

        const requestedLanguage = this.getAttribute('lang') || this.getAttribute('language') || 'text';

        const label = this.getAttribute('label') || this.getAttribute('filename') || null;

        const language = normalizeLanguage(requestedLanguage);

        this.dataset.shikiState = 'loading';

        try {
          const highlighter = await getHighlighter();

          let loadedLanguage = language;

          try {
            loadedLanguage = await ensureLanguage(highlighter, language);
          } catch (error) {
            console.warn(`Shiki could not load language "${language}". Falling back to plain text.`, error);

            loadedLanguage = 'text';
          }

          const html = highlighter.codeToHtml(source, {
            lang: loadedLanguage,
            theme: DEFAULT_THEME,
          });

          const template = document.createElement('template');
          template.innerHTML = html.trim();

          const highlightedPre = template.content.firstElementChild;

          if (!highlightedPre) {
            throw new Error('Shiki returned no <pre> element');
          }

          highlightedPre.classList.add('shiki-code__pre');
          highlightedPre.tabIndex = 0;

          const toolbar = createToolbar({
            label,
            language: requestedLanguage,
            source,
          });

          /*
           * Atomic upgrade.
           *
           * Until everything above succeeds, Webflow/browser keeps displaying
           * the original <pre><code> fallback.
           */
          this.replaceChildren(toolbar, highlightedPre);

          this.dataset.shikiState = 'ready';
        } catch (error) {
          /*
           * Crucial behavior:
           *
           * DO NOT replace the fallback with an error message.
           * The original <pre><code> remains visible.
           */
          this.dataset.shikiState = 'error';

          console.warn('Could not initialize Shiki code block', error);
        }
      }
    }

    if (!customElements.get('shiki-code')) {
      customElements.define('shiki-code', ShikiCode);
    }
  }
</script>

