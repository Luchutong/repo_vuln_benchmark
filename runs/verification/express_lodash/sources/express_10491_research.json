<script>
  (function () {
    var path = window.location.pathname;

    var shouldTrack = /^\/(?:[a-z]{2}\/)?support\//.test(path) || /^\/(?:[a-z]{2}\/)?pricing\/?$/.test(path) || /^\/(?:[a-z]{2}\/)?contact\/?$/.test(path);

    if (!shouldTrack) return;

    var wrappers = document.querySelectorAll('.w-form.hd-track-conversion');

    wrappers.forEach(function (wrapper) {
      var successBlock = wrapper.querySelector('.w-form-done');
      if (!successBlock) return;

      var observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (m) {
          if (m.attributeName === 'style' && successBlock.style.display === 'block') {
            fireConversion();
          }
        });
      });

      observer.observe(successBlock, { attributes: true });
    });

    function fireConversion() {
      if (typeof window.oaiq !== 'function') return; // no consent, or pixel not loaded

      oaiq(
        'measure',
        'lead_created',
        { type: 'customer_action' },
        {
          event_id: 'form_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8),
        },
      );
    }
  })();

  // fire event when a white paper or ebook is downloaded
  document.addEventListener('click', function (e) {
    var btn = e.target.closest('#download-pdf');
    if (!btn) return;

    if (typeof window.oaiq !== 'function') return; // no consent yet, or pixel not loaded

    oaiq(
      'measure',
      'custom',
      { type: 'custom' },
      {
        custom_event_name: 'content_download',
        event_id: 'download_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8),
      },
    );
  });
</script>

