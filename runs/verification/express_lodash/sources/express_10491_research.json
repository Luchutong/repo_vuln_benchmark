async function getVEXData() {
  const url = `https://apps.herodevs.com/api/ontology/vex/statements?download=true&vulnerability=CVE-2024-10491`;
  const itemTable = document.getElementById("vex-row");
  const linkEl = document.querySelector(".link-vex_vulnerability");

  try {
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`Response status: ${response.status}`);
    }

    const result = await response.json();
    console.log(result);

    const hasStatements = result.statements.length > 0;

    if (hasStatements && linkEl) {
      const vexLink = `https://apps.herodevs.com/api/ontology/vex/statements?download=true&vulnerability=CVE-2024-10491`;
      linkEl.href = vexLink;
      linkEl.download = "herodevs.openvex.json";
    } else {
      itemTable.style.display = "none";
    }

    return !!hasStatements;

  } catch (error) {
    console.error(error.message);
    itemTable.style.display = "none";
    return false;
  }
}

document.addEventListener("DOMContentLoaded", () => {
  getVEXData();
});
