--- a/tests/queries/tests.py
+++ b/tests/queries/tests.py
@@ -3134,6 +3134,14 @@ def test_invalid_order_by(self):
         with self.assertRaisesMessage(FieldError, msg):
             Article.objects.order_by('*')
 
