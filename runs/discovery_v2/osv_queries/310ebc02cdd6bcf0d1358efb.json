/symfony/CVE-2017-16653.yaml"}, {"type": "PACKAGE", "url": "https://github.com/symfony/symfony"}, {"type": "WEB", "url": "https://symfony.com/blog/cve-2017-16653-csrf-protection-does-not-use-different-tokens-for-http-and-https"}, {"type": "WEB", "url": "https://symfony.com/cve-2017-16653"}, {"type": "WEB", "url": "https://www.debian.org/security/2018/dsa-4262"}], "schema_version": "1.9.0", "severity": [{"score": "CVSS:3.0/AV:N/AC:H/PR:N/UI:N/S:U/C:H/I:N/A:N", "type": "CVSS_V3"}], "summary": "Symfony CSRF Vulnerability"}], "repo": "symfony/symfony", "round": "expanded_component_query", "scope_note": "First-party monorepo component or explicit mapping hypothesis; third-party transitive dependency vulnerabilities are not attributed automatically.", "source_family": "public_vulnerability_database", "status": "PASS_QUERY_ONLY"}
