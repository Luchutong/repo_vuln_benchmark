://github.com/labstack/echo/issues/2259"}, {"type": "WEB", "url": "https://github.com/labstack/echo/pull/2260"}, {"type": "WEB", "url": "https://github.com/labstack/echo/pull/2260/commits/3154abd1401554fe4d1c09ec550506d8625fc042"}, {"type": "WEB", "url": "https://github.com/labstack/echo/commit/0ac4d74402391912ff6da733bb09fd4c3980b4e1"}, {"type": "PACKAGE", "url": "https://github.com/labstack/echo"}, {"type": "WEB", "url": "https://github.com/labstack/echo/releases/tag/v4.9.0"}, {"type": "WEB", "url": "https://pkg.go.dev/vuln/GO-2022-1031"}], "schema_version": "1.9.0", "severity": [{"score": "CVSS:3.1/AV:N/AC:L/PR:N/UI:R/S:C/C:H/I:H/A:H", "type": "CVSS_V3"}], "summary": "Labstack Echo Open Redirect vulnerability"}, {"affected": [{"database_specific": {"source": "https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2022/12/GHSA-j453-hm5x-c46w/GHSA-j453-hm5x-c46w.json"}, "package": {"ecosystem": "Go", "name": "github.com/labstack/echo/v4", "purl": "pkg:golang/github.com/labstack/echo/v4"}, "ranges": [{"events": [{"introduced": "0"}, {"fixed": "4.2.0"}], "type": "SEMVER"}]}], "aliases": ["CVE-2020-36565", "GO-2021-0051"], "database_specific": {"cwe_ids": ["CWE-22"], "github_reviewed": true, "github_reviewed_at": "2022-12-07T20:46:25Z", "nvd_published_at": "2022-12-07T17:15:00Z", "severity": "MODERATE"}, "details": "Due to improper sanitization of user input on Windows, the static file handler allows for directory traversal, allowing an attacker to read files outside of the target directory that the server has permission to read.", "id": "GHSA-j453-hm5x-c46w", "modified": "2023-11-08T04:03:47.726196Z", "published": "2022-12-07T18:30:26Z", "references": [{"type": "ADVISORY", "url": "https://nvd.nist.gov/vuln/detail/CVE-2020-36565"}, {"type": "WEB", "url": "https://github.com/labstack/echo/pull/1718"}, {"type": "WEB", "url": "https://github.com/labstack/echo/commit/4422e3b66b9fd498ed1ae1d0242d660d0ed3faaa"}, {"type": "PACKAGE", "url": "https://github.com/labstack/echo"}, {"type": "WEB", "url": "https://pkg.go.dev/vuln/GO-2021-0051"}], "schema_version": "1.9.0", "severity": [{"score": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:L/I:N/A:N", "type": "CVSS_V3"}], "summary": "Echo vulnerable to directory traversal"}, {"affected": [{"database_specific": {"source": "https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/08/GHSA-vfp3-v2gw-7wfq/GHSA-vfp3-v2gw-7wfq.json"}, "package": {"ecosystem": "Go", "name": "github.com/labstack/echo/v5", "purl": "pkg:golang/github.com/labstack/echo/v5"}, "ranges": [{"events": [{"introduced": "0"}, {"fixed": "5.2.0"}], "type": "SEMVER"}]}, {"database_specific": {"source": "https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/08/GHSA-vfp3-v2gw-7wfq/GHSA-vfp3-v2gw-7wfq.json"}, "package": {"ecosystem": "Go", "name": "github.com/labstack/echo/v4", "purl": "pkg:golang/github.com/labstack/echo/v4"}, "ranges": [{"events": [{"introduced": "0"}, {"fixed": "4.15.3"}], "type": "SEMVER"}]}, {"database_specific": {"source": "https://github.com/github/advisory-database/blob/main/advisories/github-reviewed/2026/08/GHSA-vfp3-v2gw-7wfq/GHSA-vfp3-v2gw-7wfq.json"}, "package": {"ecosystem": "Go", "name": "github.com/labstack/echo", "purl": "pkg:golang/github.com/labstack/echo"}, "ranges": [{"events": [{"introduced": "0"}, {"last_affected": "3.3.10"}], "type": "SEMVER"}]}], "aliases": ["CVE-2026-55677", "GO-2026-6293"], "database_specific": {"cwe_ids": ["CWE-22"], "github_reviewed": true, "github_reviewed_at": "2026-08-25T16:13:29Z", "nvd_published_at": "2026-06-26T17:16:34Z", "severity": "HIGH"}, "details": "### Summary\n\nEcho's router and static file handler disagree on URL path decoding. The router matches routes using the raw encoded path (preserving `%2F` as-is), while `StaticDirectoryHandler` unescapes `%2F` to `/` before resolving filesystem paths. This allows an attacker to bypass route-level access controls and read static files without authorization.\n\n### Details\n\n**Root cause 1 — `router.go` lines 798-802:**\nThe router uses `req.URL.RawPath` for route matching when `useEscapedPathForRouting` is false (the default). This means `/admin%2Fsecret.txt` is treated as a single path segment and does NOT match the `/admin/*` route pattern.\n\n```go\nif !r.useEscapedPathForRouting && req.URL.RawPath != \"\" {\n    path = req.URL.RawPath\n}\n```\n\n**Root cause 2 — `echo.go` lines 559-568:**\n`StaticDirectoryHandler` calls `url.PathUnescape()` on the path parameter before opening files. This converts `%2F` back to `/`, resolving `admin/secret.txt` on disk.\n\n```go\nif !disablePathUnescaping {\n    tmpPath, err := url.PathUnescape(p)\n    p = tmpPath\n}\nname := filepath.ToSlash(filepath.Clean(strings.TrimPrefix(p, \"/\")))\n```\n\n### PoC (Screenshot)\nSample:\n<img width=\"1291\" height=\"970\" alt=\"image\" src=\"https://github.com/user-attachments/assets/0bc58059-3e6d-4678-ab25-a5c79b006738\" />\n\n403:\n<img width=\"526\" height=\"194\" alt=\"image\" src=\"https://github.com/user-attachments/assets/2f55ffdd-87b2-4a1b-8a13-130ebad0f257\" />\n\nBypass with encoded slash:\n<img width=\"592\" height=\"203\" alt=\"image\" src=\"https://github.com/user-attachments/assets/1191cd39-ae8f-4d7e-8fb1-cb9cf31f484f\" />\n\n### Impact\n\nUnauthorized static file disclosure. Applications that protect route prefixes with authentication middleware while also serving static files from a broader root are vulnerable. An attacker only needs to encode the slash (`/` → `%2F`) in the URL to bypass all route-level protection.\n\nCommon affected pattern:\n```go\nadminGroup := e.Group(\"/admin\", authMiddleware)\ne.StaticFS(\"/\", os.DirFS(\"public\"))\n```", "id": "GHSA-vfp3-v2gw-7wfq", "modified": "2026-09-10T03:51:14.774124457Z", "published": "2026-08-25T16:13:29Z", "references": [{"type": "WEB", "url": "https://github.com/labstack/echo/security/advisories/GHSA-vfp3-v2gw-7wfq"}, {"type": "ADVISORY", "url": "https://nvd.nist.gov/vuln/detail/CVE-2026-55677"}, {"type": "WEB", "url": "https://github.com/labstack/echo/pull/3009"}, {"type": "WEB", "url": "https://github.com/labstack/echo/pull/3011"}, {"type": "WEB", "url": "https://github.com/labstack/echo/commit/8d1ae9d3360a71672418856d58753af25f2c3986"}, {"type": "WEB", "url": "https://github.com/labstack/echo/commit/c3fa2a27ff92b2b8db360de614f999ef1da24725"}, {"type": "PACKAGE", "url": "https://github.com/labstack/echo"}, {"type": "WEB", "url": "https://github.com/labstack/echo/releases/tag/v4.15.3"}, {"type": "WEB", "url": "https://github.com/labstack/echo/releases/tag/v5.2.0"}], "schema_version": "1.9.0", "severity": [{"score": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:U/C:H/I:N/A:N", "type": "CVSS_V3"}], "summary": "Echo: Encoded slash (%2F) bypasses route-level protection and exposes static files"}, {"affected": [{"database_specific": {"source": "https://vuln.go.dev/ID/GO-2021-0051.json"}, "ecosystem_specific": {"imports": [{"goos": ["windows"], "path": "github.com/labstack/echo/v4", "symbols": ["Echo.Static", "Group.Static", "common.static"]}]}, "package": {"ecosystem": "Go", "name": "github.com/labstack/echo/v4", "purl": "pkg:golang/github.com/labstack/echo/v4"}, "ranges": [{"events": [{"introduced": "0"}, {"fixed": "4.1.18-0.20201215153152-4422e3b66b9f"}], "type": "SEMVER"}]}], "aliases": ["CVE-2020-36565", "GHSA-j453-hm5x-c46w"], "credits": [{"name": "@little-cui (Apache ServiceComb)"}], "database_specific": {"review_status": "REVIEWED", "url": "https://pkg.go.dev/vuln/GO-2021-0051"}, "details": "Due to improper sanitization of user input on Windows, the static file handler allows for directory traversal, allowing an attacker to read files outside of the target directory that the server has permission to read.", "id": "GO-2021-0051", "modified": "2024-05-20T16:03:47Z", "published": "2021-04-14T20:04:52Z", "references": [{"type": "FIX", "url": "https://github.com/labstack/echo/pull/1718"}, {"type": "FIX", "url": "https://github.com/labstack/echo/commit/4422e3b66b9fd498ed1ae1d0242d660d0ed3faaa"}], "schema_version": "1.7.3", "summary": "Directory traversal on Windows in github.com/labstack/echo/v4"}, {"affected": [{"database_specific": {"source": "https://vuln.go.dev/ID/GO-2022-1031.json"}, "ecosystem_specific": {"imports": [{"path": "github.com/labstack/echo/v4", "symbols": ["Echo.Static", "Echo.StaticFS", "Group.Static", "Group.StaticFS", "StaticDirectoryHandler"]}]}, "package": {"ecosystem": "Go", "name": "github.com/labstack/echo/v4", "purl": "pkg:golang/github.com/labstack/echo/v4"}, "ranges": [{"events": [{"introduced": "0"}, {"fixed": "4.9.0"}], "type": "SEMVER"}]}], "aliases": ["CVE-2022-40083", "GHSA-crxj-hrmp-4rwf"], "database_specific": {"review_status": "REVIEWED", "url": "https://pkg.go.dev/vuln/GO-2022-1031"}, "details": "Labstack Echo contains an open redirect vulnerability via the Static Handler component. This vulnerability can be leveraged by attackers to cause a Server-Side Request Forgery (SSRF).", "id": "GO-2022-1031", "modified": "2024-05-20T16:03:47Z", "published": "2022-10-11T21:29:24Z", "references": [{"type": "REPORT", "url": "https://github.com/labstack/echo/issues/2259"}, {"type": "FIX", "url": "https://github.com/labstack/echo/pull/2260"}], "schema_version": "1.7.3", "summary": "Open redirect in github.com/labstack/echo/v4"}, {"affected": [{"database_specific": {"source": "https://vuln.go.dev/ID/GO-2026-6293.json"}, "ecosystem_specific": {"imports": [{"path": "github.com/labstack/echo/v4", "symbols": ["Echo.Static", "Echo.StaticFS", "Group.Static", "Group.StaticFS", "StaticDirectoryHandler"]}, {"path": "github.com/labstack/echo/v4/middleware", "symbols": ["Static", "StaticWithConfig"]}]}, "package": {"ecosystem": "Go", "name": "github.com/labstack/echo/v4", "purl": "pkg:golang/github.com/labstack/echo/v4"}, "ranges": [{"events": [{"introduced": "0"}, {"fixed": "4.15.3"}], "type": "SEMVER"}]}, {"database_specific": {"source": "https://vuln.go.dev/ID/GO-2026-6293.json"}, 