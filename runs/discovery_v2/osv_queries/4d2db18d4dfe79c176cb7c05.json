type": "WEB", "url": "https://github.com/symfony/symfony/commit/296d4b34a33b1a6ca5475c6040b3203622520f5b"}, {"type": "WEB", "url": "https://github.com/FriendsOfPHP/security-advisories/blob/master/symfony/http-client/CVE-2024-50342.yaml"}, {"type": "WEB", "url": "https://github.com/FriendsOfPHP/security-advisories/blob/master/symfony/symfony/CVE-2024-50342.yaml"}, {"type": "PACKAGE", "url": "https://github.com/symfony/symfony"}, {"type": "WEB", "url": "https://symfony.com/cve-2024-50342"}], "schema_version": "1.9.0", "severity": [{"score": "CVSS:3.1/AV:N/AC:H/PR:L/UI:N/S:U/C:L/I:N/A:N", "type": "CVSS_V3"}, {"score": "CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:L/VI:N/VA:N/SC:N/SI:N/SA:N", "type": "CVSS_V4"}], "summary": "Symfony allows internal address and port enumeration by NoPrivateNetworkHttpClient"}], "repo": "symfony/symfony", "round": "expanded_component_query", "scope_note": "First-party monorepo component or explicit mapping hypothesis; third-party transitive dependency vulnerabilities are not attributed automatically.", "source_family": "public_vulnerability_database", "status": "PASS_QUERY_ONLY"}
