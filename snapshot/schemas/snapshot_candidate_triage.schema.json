{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["candidate_id", "repo_id", "snapshot_id", "decision", "basis", "evidence_urls"],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "repo_id": {"type": "string", "minLength": 1},
    "snapshot_id": {"type": "string", "minLength": 1},
    "vulnerability_id": {"type": ["string", "null"]},
    "decision": {"enum": ["confirmed_affected", "confirmed_not_affected", "duplicate", "out_of_scope", "possible_affected", "unknown"]},
    "canonical_candidate_id": {"type": ["string", "null"]},
    "basis": {"type": "string", "minLength": 1},
    "evidence_urls": {"type": "array", "items": {"type": "string", "pattern": "^https://"}},
    "review_method": {"enum": ["trusted_range_with_branch", "source_diff", "source_code_review", "upstream_advisory", "alias_cluster", "unresolved", "advisory_plus_static_source"]},
    "checked_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": true
}
