{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "run_id",
    "finding_id",
    "snapshot_id",
    "repo_id",
    "title",
    "category",
    "locations",
    "evidence_summary"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "repo_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "line": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "string",
                "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"
              }
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "evidence_summary": {
      "type": "string",
      "minLength": 1
    },
    "claimed_severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "finding_confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    }
  },
  "additionalProperties": true
}
